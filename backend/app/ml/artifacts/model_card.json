    "commit_frequency_28d",
    "commit_trend",
    "task_velocity",
    "open_task_ratio",
    "overdue_task_count",
    "deadline_slippage_days",
    "blocked_task_ratio",
    "days_to_deadline",
    "workload_concentration",
    "email_activity_trend",
    "meeting_load"
