  "metrics": {
    "cv_roc_auc": 0.8789,
    "test_roc_auc": 0.8661,
    "test_accuracy": 0.7829,
    "test_precision": 0.7106,
    "test_recall": 0.6653,
    "baseline_lr_cv_roc_auc": 0.8789,
