# TwinOS Environment Configuration
# Copy this file to .env and adjust as necessary for your deployment.

# Environment Mode
ENV=development
LOG_LEVEL=INFO
SECRET_KEY=twinos-dev-super-secret-key-32charsmin-change-prod!
# 32-byte url-safe base64 key for Fernet token encryption
ENCRYPTION_KEY=2bTqZ5E2d0G6f8H0J2L4N6P8R0T2V4X6Z8b0d2f4h6j=

# Auth Configuration: 'dev' or 'firebase'
# dev mode accepts Authorization: Bearer dev:<email> for seeded accounts
AUTH_MODE=dev
FIREBASE_PROJECT_ID=twinos-dev-placeholder
FIREBASE_CREDENTIALS_PATH=

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=twinos
POSTGRES_USER=twinos
POSTGRES_PASSWORD=twinos_password
DATABASE_URL=postgresql://twinos:twinos_password@localhost:5432/twinos
# If running without local PostgreSQL or Docker, SQLite fallback can be used:
# DATABASE_URL=sqlite:///./twinos.db

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=twinos_password
NEO4J_DATABASE=neo4j
# Use in-memory graph driver fallback when Neo4j is not reachable
NEO4J_MOCK_FALLBACK=true

# Chroma Vector Store
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_MOCK_FALLBACK=true

# AI / LLM Provider: 'mock', 'openai', or 'gemini'
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=mock

# External Integration Credentials (leave blank to run in mock mode)
GITHUB_TOKEN=
TRELLO_API_KEY=
TRELLO_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/oauth/callback

# Web & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AUTH_MODE=dev
